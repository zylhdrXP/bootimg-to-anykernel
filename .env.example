# Telegram Bot Token obtained from @BotFather (Required)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Telegram API credentials from https://my.telegram.org (Required for Pyrogram to bypass 20MB file limit)
TELEGRAM_API_ID=your_api_id_here
TELEGRAM_API_HASH=your_api_hash_here

# Bot Owner's Telegram User ID (Exempt from the 3 runs per day limit. Use a bot like @userinfobot to get your ID)
OWNER_ID=your_telegram_user_id_here

# AnyKernel Repository to clone and modify (Optional, defaults to osm0sis/AnyKernel3)
ANYKERNEL_REPO=https://github.com/osm0sis/AnyKernel3.git

# AnyKernel Repository Branch to clone (Optional, defaults to master)
ANYKERNEL_BRANCH=master

# gofile.io account token (Optional). If empty, a temporary anonymous account is created per download.
GF_TOKEN=

# gofile.io connection/read timeout in seconds (Optional, defaults to 15.0)
GF_TIMEOUT=15.0
